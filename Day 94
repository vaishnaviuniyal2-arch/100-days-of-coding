Find and print the student with the highest marks.
#include <stdio.h>
struct Student {
    char name[50];
    int marks;
};

int main() {
    int n, i;
    scanf("%d", &n);

    struct Student s[n];

    for (i = 0; i < n; i++) {
        scanf("%s", s[i].name);
        scanf("%d", &s[i].marks);
    }

    int maxIndex = 0;
    for (i = 1; i < n; i++) {
        if (s[i].marks > s[maxIndex].marks) {
            maxIndex = i;
        }
    }

    printf("%s %d", s[maxIndex].name, s[maxIndex].marks);
    return 0;
}
